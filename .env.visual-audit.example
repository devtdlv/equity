# Template for Equity Phase 6 visual-audit isolation.
# Do not copy secrets from a real .env. Prefer:
#   php artisan equity:visual-audit-prepare
# which writes .env.visual-audit (gitignored) with a dedicated key and
# an absolute SQLite path outside this repository.

APP_NAME=Equity
APP_ENV=visual-audit
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

EQUITY_VISUAL_AUDIT=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Absolute path OUTSIDE the repository, never database/database.sqlite
DB_DATABASE=
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=equity_visual_audit_

MAIL_MAILER=array
MAIL_FROM_ADDRESS="demo@equity.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
