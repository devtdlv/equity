<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force=true overwrites getenv/$_ENV. Matching <server> overwrites $_SERVER, which Laravel Env reads first. PHPUnit 11.5 does not unset inherited keys. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value=""/>
        <env name="DATABASE_URL" value="" force="true"/>
        <server name="DATABASE_URL" value=""/>
        <env name="DB_SOCKET" value="" force="true"/>
        <server name="DB_SOCKET" value=""/>
        <env name="DB_UNIX_SOCKET" value="" force="true"/>
        <server name="DB_UNIX_SOCKET" value=""/>
        <env name="DB_HOST" value="" force="true"/>
        <server name="DB_HOST" value=""/>
        <env name="DB_PORT" value="" force="true"/>
        <server name="DB_PORT" value=""/>
        <env name="DB_USERNAME" value="" force="true"/>
        <server name="DB_USERNAME" value=""/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <server name="DB_PASSWORD" value=""/>
        <env name="DB_DSN" value="" force="true"/>
        <server name="DB_DSN" value=""/>
        <env name="MYSQL_PWD" value="" force="true"/>
        <server name="MYSQL_PWD" value=""/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-config-must-not-exist.php" force="true"/>
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-config-must-not-exist.php"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
